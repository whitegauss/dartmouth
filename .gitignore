# --- Python / ツール ---
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.log

# --- 個人のデータ（公開しない） ---
# 会議の記録（発言・議事録・編集の下書き）。仕組みのための .gitkeep だけ残す
meetings/*
!meetings/.gitkeep
# 個人の会議資料（個人用の会議設定は local/ か *.local.yaml に置く）
context/
# 各自の設定（dm init で作る。個人用ディレクトリに置いてもよい）
config.yaml
agents.yaml
# 個人用のファイルはここに置けば公開されない（あとで個人用と開発用を分けるときの置き場）
local/
*.local.yaml
# 設定画面で保存したときの前の版
*.bak
# 資料庫の索引
.dartmouth-index/

# 書き出し（全アイテムの Markdown など。個人のデータを含む）
exports/
